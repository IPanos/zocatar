; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are just too many and change too frequently.
; Refer to the docs for the full list of settings here:
; https://docs.godotengine.org/en/stable/tutorials/projects/project_settings.html

config_version=5

[application]

config/name="Zocatar"
config/description="A retro 16-bit mobile 2D RPG inspired by GBA-style Pokémon games"
run/main_scene="res://scenes/overworld/overworld.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
ScalingEngine="*res://scripts/systems/scaling_engine.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=240
window/stretch/mode="canvas_items"
window/stretch/scale=3.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
